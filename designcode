def coloring(eye_color, undertones, haircolor):
    flattering_colors = [] #will add in flattering_colors for eye color, undertones and hair color
    lessflattering_colors = []
    #undecided if i will make one list for all colors or make separate colors for each input (eye color, etc.). i'm thinking just one list of colors so that it's not too overwhelming?
    #for each, some that complement and some that contrast
    if eye_color == 'blue':
        flattering_colors.extend(['saphhire', 'emerald', 'bronze', 'peach'])

    if eye_color == 'green':
        flattering_colors.extend(['emerald', 'olive', 'lavender', 'plum'])

    if eye_color == 'brown':
        flattering_colors.extend(['cerulean', 'lavender', 'gold', 'maroon'])

    if undertones == 'warm':
        flattering_colors.extend(['coral', 'orange', 'teal', 'ivory'])
        lessflattering_colors.extend(['lavender', 'sapphire', 'emerald']) #colors it says to avoid
    if undertones == 'cool':
        flattering_colors.extend(['royal blue', 'emerald', 'maroon'])
        lessflattering_colors.extend(['coral', 'orange', 'olive'])
    if haircolor == 'brown':
        flattering_colors.extend(['ruby', 'emerald', 'light pink', 'plum'])
        lessflattering_colors.extend(['orange', 'brown', 'grey'])
    if haircolor == 'blonde':
        flattering_colors.extend(['navy', 'cobalt', 'pink', 'black'])
        lessflattering_colors.extend(['orange', 'yellow', 'beige'])
    if haircolor == 'black':
        flattering_colors.extend(['ivory', 'emerald', 'amethyst', 'true red'])
        lessflattering_colors.extend(['beige'])
    if haircolor == 'red':
        flattering_colors.extend(['emerald', 'cobalt', 'plum', 'ivory'])
        lessflattering_colors.extend(['orange', 'yellow'])
    return flattering_colors, lessflattering_colors


#colors input will be flattering_colors, exclude input will be lessflattering_colors
def dedupe_and_filter_colors(colors, exclude):
    exclude_set = set(exclude) #converts exclude list into a set
    seen = set()
    filtered = []
    for color in colors:
        if color in exclude_set:
            continue #skips over rest of function; colors in lessflattering will not be added to the filtered list
        if color in seen:
            continue #skips over colors already in seen list to avoid duplicates
        seen.add(color) #added to both lists if not already seen and not in lessflattering
        filtered.append(color)
    return filtered


def find_repeated_colors(colors):
    counts = {}
    repeated = []
    for color in colors:
        counts[color] = counts.get(color, 0) + 1 #starts at 0, counts up
    for color in colors:
        if counts[color] > 1 and color not in repeated:
            repeated.append(color)
    return repeated


def format_color_list(colors):
    if not colors:
        return ''
    if len(colors) == 1:
        return colors[0]
    if len(colors) == 2:
        return ' and '.join(colors)
    return ', '.join(colors[:-1]) + ', and ' + colors[-1]

flattering_colors, lessflattering_colors = coloring(eye_color, undertones, haircolor)
final_colors = dedupe_and_filter_colors(flattering_colors, lessflattering_colors)
print(f'Good colors for you to wear are: {format_color_list(final_colors)}.')

repeated_colors = find_repeated_colors(flattering_colors)
highlighted_colors = dedupe_and_filter_colors(repeated_colors, lessflattering_colors)
if highlighted_colors:
    print(f'We especially recommend these color[s]: {format_color_list(highlighted_colors)}.')



